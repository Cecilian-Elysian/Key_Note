<UserControl
    x:Class="KeyNote.App.Controls.KpiCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border x:Name="Root" Style="{StaticResource AppKpiCardStyle}">
        <StackPanel Spacing="2">
            <TextBlock x:Name="LabelText" Style="{StaticResource CardLabelStyle}" Text="标签" />
            <TextBlock x:Name="ValueText" Style="{StaticResource CardValueStyle}" Text="—" />
            <TextBlock x:Name="FootText" Style="{StaticResource CardFootnoteStyle}" Text="" />
        </StackPanel>
    </Border>
</UserControl>
