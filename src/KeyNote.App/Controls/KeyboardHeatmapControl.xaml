<UserControl
    x:Class="KeyNote.App.Controls.KeyboardHeatmapControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Canvas x:Name="Surface" />
        <Border x:Name="Tip" Visibility="Collapsed" CornerRadius="4" Padding="8,4"
                Background="#F21C1C1C" BorderBrush="#FF3D3D3D" BorderThickness="1"
                HorizontalAlignment="Left" VerticalAlignment="Top">
            <TextBlock x:Name="TipText" FontSize="11" Foreground="#FFFFFFFF" />
        </Border>
    </Grid>
</UserControl>
