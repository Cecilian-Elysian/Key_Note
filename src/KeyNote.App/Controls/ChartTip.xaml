<UserControl
    x:Class="KeyNote.App.Controls.ChartTip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border x:Name="TipBorder" Visibility="Collapsed" CornerRadius="4" Padding="8,4"
            Background="{ThemeResource ChartTipBackgroundBrush}"
            BorderBrush="{ThemeResource ChartTipBorderBrush}" BorderThickness="1"
            HorizontalAlignment="Left" VerticalAlignment="Top">
        <TextBlock x:Name="TipText" FontSize="11" Foreground="{ThemeResource ChartTipForegroundBrush}" />
    </Border>
</UserControl>
