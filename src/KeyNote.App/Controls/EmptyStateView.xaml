<UserControl
    x:Class="KeyNote.App.Controls.EmptyStateView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="6" HorizontalAlignment="Center">
        <FontIcon x:Name="EmptyIcon" Glyph="&#xE787;" FontSize="26"
                  Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
        <TextBlock x:Name="EmptyTitle" FontSize="14"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
        <TextBlock x:Name="EmptyHint" FontSize="11"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
    </StackPanel>
</UserControl>
