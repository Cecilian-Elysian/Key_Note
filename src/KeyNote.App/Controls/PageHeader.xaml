<UserControl
    x:Class="KeyNote.App.Controls.PageHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid ColumnDefinitions="*,Auto">
        <StackPanel VerticalAlignment="Center" Spacing="2">
            <TextBlock x:Name="TitleText" Style="{StaticResource PageTitleStyle}" Text="标题" />
            <TextBlock x:Name="SubtitleText" Style="{StaticResource PageSubTitleStyle}" Text="" />
        </StackPanel>
        <Button x:Name="RefreshButton" Grid.Column="1" VerticalAlignment="Center"
                Padding="10,5,10,5" CornerRadius="4"
                Background="Transparent" BorderThickness="0"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon Glyph="&#xE72C;" FontSize="12" />
                <TextBlock Text="刷新" FontSize="12" />
            </StackPanel>
        </Button>
    </Grid>
</UserControl>
