<Page
    x:Class="KeyNote.App.Views.HeatmapPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:KeyNote.App.Controls">
    <ScrollViewer Padding="20,16,20,16">
        <StackPanel Spacing="12">
            <controls:PageHeader x:Name="Header" Title="热力图" Subtitle="" />

            <!-- 年度热力图卡 -->
            <Border Style="{StaticResource AppCardStyle}">
                <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock x:Name="YearTitle" Grid.Column="0" Style="{StaticResource CardTitleStyle}"
                                   Text="过去 365 天 · 每日贡献" />
                        <TextBlock x:Name="YearSummary" Grid.Column="1" Style="{StaticResource CardFootnoteStyle}"
                                   VerticalAlignment="Center" Text="" />
                    </Grid>
                    <controls:GhHeatmapControl x:Name="Heatmap" Height="320" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
