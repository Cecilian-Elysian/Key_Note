<Page
    x:Class="KeyNote.App.Views.KeyboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:KeyNote.App.Controls">
    <Grid RowDefinitions="Auto,*">
        <!-- 页头固定,不随内容滚动 -->
        <controls:PageHeader x:Name="Header" Title="后台" Subtitle="键盘与鼠标活动分布" Margin="20,16,20,0" />

        <ScrollViewer Grid.Row="1" Padding="20,10,20,16"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="12">
                <!-- 7×24 卡 -->
                <Border Style="{StaticResource AppCardStyle}">
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Style="{StaticResource CardTitleStyle}" Text="7×24 小时活跃度" />
                            <TextBlock x:Name="HourlySummary" Grid.Column="1" Style="{StaticResource CardFootnoteStyle}"
                                       VerticalAlignment="Center" Text="" />
                        </Grid>
                        <controls:HourlyGridControl x:Name="HourlyGrid" Height="150" />
                    </StackPanel>
                </Border>

                <!-- QWERTY 键盘热力图卡 -->
                <Border Style="{StaticResource AppCardStyle}">
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Style="{StaticResource CardTitleStyle}" Text="按键分布热力图" />
                            <TextBlock x:Name="KbLegend" Grid.Column="1" Style="{StaticResource CardFootnoteStyle}"
                                       VerticalAlignment="Center" Text="" />
                        </Grid>
                        <controls:KeyboardHeatmapControl x:Name="KeyboardHeatmap" Height="200" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
