<Page
    x:Class="KeyNote.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:KeyNote.App.Controls">
    <Grid RowDefinitions="Auto,Auto,*">
        <!-- 页头 -->
        <controls:PageHeader x:Name="Header" Grid.Row="0" Margin="20,16,20,0"
                             Title="设置" Subtitle="启动方式、界面与数据备份" />

        <!-- 搜索 -->
        <TextBox x:Name="SearchBox" Grid.Row="1" Margin="20,10,20,0"
                 PlaceholderText="搜索设置项" Height="32" />

        <!-- 分组 + 行 -->
        <ScrollViewer Grid.Row="2" Padding="20,10,20,90" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="GroupsHost" Spacing="14" />
        </ScrollViewer>

        <!-- 固定底栏 -->
        <Border Grid.Row="2" VerticalAlignment="Bottom" Height="64"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"
                Padding="20,10,20,10">
            <Grid ColumnDefinitions="*,Auto,Auto" VerticalAlignment="Center">
                <TextBlock x:Name="StatusText" Grid.Column="0" Style="{StaticResource CardFootnoteStyle}"
                           VerticalAlignment="Center" Text="" />
                <Button x:Name="ResetButton" Grid.Column="1" Margin="0,0,8,0" Content="恢复默认"
                        Click="ResetButton_Click" Background="Transparent" BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button x:Name="SaveButton" Grid.Column="2" Content="保存设置"
                        Click="SaveButton_Click" Style="{StaticResource AccentButtonStyle}" />
            </Grid>
        </Border>
    </Grid>
</Page>
